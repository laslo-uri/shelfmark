{
  "name": "shelfmark",
  "private": true,
  "version": "0.1.0",
  "description": "Shelfmark — your personal bookshelf, scanned from real life",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build --mode mobile",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "prepare:ios-icon": "node scripts/prepare-ios-icon.mjs",
    "prepare:ios": "npm run prepare:ios-icon && npm run assets:generate && npm run build:mobile && npx cap sync ios",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icon": "tauri icon src-tauri/icon-source.svg -o src-tauri/icons",
    "desktop:shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-windows-shortcut.ps1",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:run:ios": "npm run cap:sync && npx cap run ios",
    "assets:generate": "npx capacitor-assets generate --iconBackgroundColor #1e1916 --splashBackgroundColor #1e1916"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "^0.35.4",
      "tar": "^7.5.22",
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/sora": "^5.2.5",
    "@zxing/browser": "^0.1.5",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "@eslint/js": "^9.21.0",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.5"
  }
}
